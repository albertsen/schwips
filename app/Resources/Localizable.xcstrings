    "%@, %lld ml. Remove a bottle that was added by mistake. To record a bottle you opened, use Mark as Drunk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld ml. Entferne eine Flasche, die versehentlich hinzugefügt wurde. Für eine geöffnete Flasche nutze „Als getrunken markieren“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$lld ml. Remove a bottle that was added by mistake. To record a bottle you opened, use Mark as Drunk."
